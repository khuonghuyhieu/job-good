# Copy into the deployment secret/config system; do not commit populated values.
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
WORKER_HEALTH_PORT=3001
WEB_ORIGIN=https://good-job.example.com
VITE_API_URL=https://api.good-job.example.com
VITE_WEBSOCKET_PATH=/socket.io

DATABASE_URL=postgresql://good_job:generate-a-password@postgres.example.com:5432/good_job?schema=public
REDIS_URL=redis://redis.example.com:6379

SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=gj.sid
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true
SESSION_TRUST_PROXY=true
SESSION_REDIS_PREFIX=good-job:session:
DEMO_ORGANIZATION_SLUG=amanotes-demo

API_MAX_JSON_BYTES=131072
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_COMMAND_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=good-job-media
OBJECT_STORAGE_ACCESS_KEY=configure-in-secret-manager
OBJECT_STORAGE_SECRET_KEY=generate-and-configure-in-secret-manager
OBJECT_STORAGE_FORCE_PATH_STYLE=false

MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_VIDEO_DURATION_SECONDS=180
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_WORKER_CONCURRENCY=2
MEDIA_WORKER_ATTEMPTS=3
MEDIA_WORKER_BACKOFF_MS=1000
MEDIA_PROBE_TIMEOUT_MS=30000

OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BACKOFF_MS=1000
WEBSOCKET_PATH=/socket.io

ORGANIZATION_TIMEZONE=Asia/Ho_Chi_Minh
SEED_BUSINESS_MONTH=2026-07
