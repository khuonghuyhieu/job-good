# Runtime
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WORKER_HEALTH_PORT=3001
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=good_job
POSTGRES_USER=good_job
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://good_job:local-development-only@localhost:5432/good_job?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication placeholder for Phase 2. Use a strong secret outside local development.
SESSION_SECRET=replace-with-at-least-32-characters
SESSION_COOKIE_NAME=gj.sid
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false
SESSION_TRUST_PROXY=false
SESSION_REDIS_PREFIX=good-job:session:
DEMO_ORGANIZATION_SLUG=amanotes-demo

# S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=good-job-media
OBJECT_STORAGE_ACCESS_KEY=good-job-local
OBJECT_STORAGE_SECRET_KEY=local-development-only
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Media policy (enforced in a later phase)
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_VIDEO_DURATION_SECONDS=180
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_WORKER_CONCURRENCY=2
MEDIA_WORKER_ATTEMPTS=3
MEDIA_WORKER_BACKOFF_MS=1000
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BACKOFF_MS=1000

# Realtime placeholder for the later realtime phase
WEBSOCKET_PATH=/socket.io

# Seed settings
ORGANIZATION_TIMEZONE=Asia/Ho_Chi_Minh
SEED_BUSINESS_MONTH=2026-07
